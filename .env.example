# ==============================================================================
# Environment Configuration Example
# Copy this file to .env and adjust variables to your local setup
# ==============================================================================

# Django settings
SECRET_KEY=django-insecure-change-this-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=*

# MongoDB Database URI
MONGO_URI=mongodb://localhost:27017

# Optional custom path to model weights (defaults to model/best.pt)
# PPE_MODEL_PATH=model/best.pt
